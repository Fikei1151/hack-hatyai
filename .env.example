# Run `npm run db:setup` to generate .env.local automatically from the local stack.
# Only the public/publishable key belongs in VITE_ variables. Never use a service-role/secret key.
# For a VPS, replace these two values with its public HTTPS API URL and public key, then rebuild.
VITE_SUPABASE_URL="http://127.0.0.1:56321"
VITE_SUPABASE_ANON_KEY="sb_publishable_..."
